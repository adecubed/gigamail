{
  "name": "gigamail",
  "productName": "GigaMail",
  "version": "0.3.0",
  "description": "GigaMail — secure agentic email console",
  "main": "main.js",
  "author": {
    "name": "Adecubed",
    "email": "info@adecubed.com"
  },
  "homepage": "https://adecubed.com",
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "test": "node --test",
    "test:e2e": "node tests/e2e.mjs",
    "predist": "node sync-version.js",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "jsdom": "^24.1.3"
  },
  "build": {
    "appId": "com.adecubed.gigamail",
    "productName": "GigaMail",
    "copyright": "Copyright © 2026 Adecubed",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!python-embedded/**"
    ],
    "extraResources": [
      {
        "from": "../src",
        "to": "gigamail/src",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "python-embedded",
        "to": "python",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../docs/brand/gigamail.ico",
      "publisherName": "Adecubed"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "perMachine": true,
      "installerIcon": "../docs/brand/gigamail.ico",
      "uninstallerIcon": "../docs/brand/gigamail.ico",
      "installerHeaderIcon": "../docs/brand/gigamail.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GigaMail",
      "deleteAppDataOnUninstall": false
    }
  }
}
