{
  "name": "gigamail",
  "productName": "GigaMail",
  "version": "0.6.7",
  "description": "GigaMail — secure agentic email console",
  "license": "AGPL-3.0-or-later",
  "main": "main.js",
  "desktopName": "gigamail.desktop",
  "author": {
    "name": "Adecubed",
    "email": "info@adecubed.com"
  },
  "homepage": "https://adecubed.com",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "test": "node --test \"tests/*.test.js\"",
    "test:e2e": "node tests/e2e.mjs",
    "test:packaged": "node tests/smoke_packaged.mjs",
    "test:appimage": "node tests/appimage_persistence.mjs",
    "test:runtime-update": "node tests/runtime_update.mjs",
    "predist": "node sync-version.js",
    "dist": "electron-builder --win --publish never",
    "predist:mac": "node sync-version.js",
    "dist:mac": "electron-builder --mac --publish never",
    "predist:linux": "node sync-version.js",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "jsdom": "^24.1.3"
  },
  "build": {
    "appId": "com.adecubed.gigamail",
    "productName": "GigaMail",
    "copyright": "Copyright © 2026 Adecubed",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "adecubed",
        "repo": "gigamail"
      }
    ],
    "files": [
      "**/*",
      "!dist/**",
      "!python-embedded/**",
      "!sign.js",
      "!afterpack.js",
      "!relocate_scripts.py",
      "!mac/**",
      "!linux/**"
    ],
    "extraResources": [
      {
        "from": "../src",
        "to": "gigamail/src",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "python-embedded",
        "to": "python",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../docs/brand/gigamail.ico",
      "signtoolOptions": {
        "sign": "./sign.js",
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "protocols": [{ "name": "GigaMail", "schemes": ["gigamail"] }],
    "nsis": {
      "include": "installer/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "perMachine": false,
      "installerIcon": "../docs/brand/gigamail.ico",
      "uninstallerIcon": "../docs/brand/gigamail.ico",
      "installerHeaderIcon": "../docs/brand/gigamail.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GigaMail",
      "deleteAppDataOnUninstall": false
    },
    "afterPack": "./afterpack.js",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "../docs/brand/gigamail-logo-1024.png",
      "category": "public.app-category.productivity",
      "artifactName": "GigaMail-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "mac/entitlements.plist",
      "entitlementsInherit": "mac/entitlements.plist"
    },
    "dmg": {
      "artifactName": "GigaMail-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../docs/brand/gigamail-logo-1024.png",
      "category": "Network;Email",
      "extraResources": [
        {
          "from": "linux/bin",
          "to": "bin"
        }
      ],
      "executableName": "gigamail-console",
      "syncDesktopName": true,
      "artifactName": "GigaMail-${version}-${arch}.${ext}",
      "synopsis": "Mail for your AI agent",
      "description": "GigaMail: secure agentic email console. Your agent reads, searches and drafts; sending waits for your approval.",
      "maintainer": "Adecubed <info@adecubed.com>",
      "vendor": "Adecubed",
      "desktop": {
        "entry": {
          "Keywords": "mail;email;agent;mcp;"
        }
      }
    },
    "deb": {
      "afterInstall": "linux/after-install.sh",
      "afterRemove": "linux/after-remove.sh",
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libuuid1",
        "libsecret-1-0"
      ],
      "recommends": [
        "libnotify-bin",
        "libappindicator3-1"
      ]
    }
  }
}
