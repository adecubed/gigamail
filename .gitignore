# Il sito pubblico vendorizza three.js: la cartella build/ qui dentro e' una
# dipendenza da versionare, non un artefatto di compilazione.
!docs/vendor/three/build/
!docs/vendor/three/build/*.js
# File credenziali OAuth scaricato da Google: contiene un secret,
# va nella cartella dati dell'utente, mai nel repository.
client_secret_*.json
google_client_secret.json

